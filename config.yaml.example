# Clara Configuration Example
#
# Copy to ~/.config/clara/config.yaml and customize.
# String values support ${ENV_VAR} expansion.

# Log level: trace, debug, info, warn, error (default: info)
log_level: info

# Data directory for internal storage (default: ~/.local/share/clara)
# data_dir: ~/.local/share/clara

# ── Clara HTTP/MCP Server ───────────────────────────────────────────────────
# Enables remote MCP connections and incoming webhooks.
# server:
#   listen_addr: ":4444"                         # address to bind to
#   public_url: "https://clara.example.com"      # used for webhook registration
#   shared_secret: "${CLARA_SHARED_SECRET}"      # bearer token for remote Claras

# ── MCP Servers ───────────────────────────────────────────────────────────────
# Clara manages their lifecycle and exposes their tools to Starlark.
#
# Remote Clara Example:
#   Connect to another Clara instance (e.g. Eve) to use its tools.
#   Tools are merged into the root namespace (local tools take precedence).
# - name: eve
#   url: https://eve.example.com/mcp/sse
#   token: "${EVE_SHARED_SECRET}"

mcp_servers:
  # GitHub integration via the official GitHub MCP server.
  # Install: npm install -g @modelcontextprotocol/server-github
  # - name: github
  #   command: github-mcp-server stdio
  #   env:
  #     GITHUB_PERSONAL_ACCESS_TOKEN: "${GITHUB_TOKEN}"

# ── Notification backend ───────────────────────────────────────────────────────
# Controls how notify.send and notify.ask deliver messages to you.
#
# Backends: dummy (default) | macos | webex | discord
#
notify:
  backend: dummy  # dummy | macos | webex | discord
  # webex:
  #   room_id:   "${WEBEX_NOTIFY_ROOM_ID}"
  # discord:
  #   channel_id: "${DISCORD_NOTIFY_CHANNEL_ID}"

# ── Integrations ───────────────────────────────────────────────────────────────
# Configures the native Go plugins.
integrations:
  # SQLite database integration
  db:
    path: "${HOME}/.local/share/clara/data.db"

  # Zettelkasten/Obsidian vault integration
  zk:
    vault_root: "${HOME}/Documents/Notes"

  # Webex Native Integration
  # webex:
  #   client_id:     "${WEBEX_CLIENT_ID}"      # OAuth Integration ID
  #   client_secret: "${WEBEX_CLIENT_SECRET}"  # OAuth Integration Secret
  #   bot_token:     "${WEBEX_BOT_TOKEN}"     # Bot account token
  #   webhook_secret: "${WEBEX_WEBHOOK_SECRET}" # HMAC key for signature verification
  #   base_url:      "https://clara.example.com" # Public URL for callbacks
  #   secret:        "${CLARA_SHARED_SECRET}"  # Shared secret for local auth

  # Discord Native Integration
  # discord:
  #   token:  "${DISCORD_BOT_TOKEN}"
  #   secret: "${CLARA_SHARED_SECRET}"         # Shared secret for local auth

  # LLM multiplexer
  # llm:
  #   providers:
  #     ollama:
  #       base_url: http://localhost:11434
  #     gemini:
  #       api_key: "${GEMINI_API_KEY}"
  #     openai:
  #       base_url: https://api.openai.com/v1
  #       key: "${OPENAI_API_KEY}"
  #   categories:
  #     fast:
  #       - provider: gemini
  #         model: gemini-2.0-flash
  #     reasoning:
