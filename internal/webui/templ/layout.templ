package templ

templ Layout(vm *LayoutVM, children ...any) {
	<div class="drawer lg:drawer-open">
		<input id="clara-drawer" type="checkbox" class="drawer-toggle"/>
		<div class="flex flex-col min-h-screen drawer-content bg-base-200">
			@Navbar(vm.Navbar)
			<main class="flex-grow p-4 md:p-6 lg:p-8 max-w-7xl w-full mx-auto">
				{ children... }
			</main>
		</div>
		<div class="drawer-side z-40">
			@Drawer(vm.Drawer)
		</div>
	</div>
}

// PageHeader renders an M3 style page title section.
templ PageHeader(title, subtitle string) {
	<div class="mb-6">
		<h1 class="text-2xl sm:text-3xl font-semibold tracking-tight m3-headline text-base-content">{ title }</h1>
		if subtitle != "" {
			<p class="text-sm text-base-content/70 mt-1">{ subtitle }</p>
		}
	</div>
}

// Flash renders an alert banner.
templ Flash(kind, message string) {
	if message != "" {
		<div class={ "alert mb-4 rounded-2xl", templ.KV("alert-success", kind == "success"), templ.KV("alert-error", kind == "error"), templ.KV("alert-warning", kind == "warning") }>
			<span>{ message }</span>
		</div>
	}
}

// StatusBadge renders a Material-style pill badge.
templ StatusBadge(status string) {
	switch status {
		case "active", "loaded", "running", "ok", "fast-path":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">{ status }</span>
		case "error", "failed":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-950/60 text-red-800 dark:text-red-300">{ status }</span>
		case "unloaded", "stopped", "idle":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-base-300/80 text-base-content/70">{ status }</span>
		default:
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border border-base-300 text-base-content/70">{ status }</span>
	}
}

// statCard renders a Material 3 tonal metric card.
templ statCard(title, value, subtitle, colorScheme string) {
	<div class="card bg-base-100 border border-base-300/80 shadow-xs p-5 rounded-2xl flex flex-col justify-between">
		<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-2">{ title }</div>
		<div class="text-3xl font-bold tracking-tight text-base-content my-1">{ value }</div>
		if subtitle != "" {
			<div class="text-xs text-base-content/60 mt-1">{ subtitle }</div>
		}
	</div>
}


