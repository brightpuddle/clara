package templ

import (
	"fmt"
)

templ ActuatorList(vm *ActuatorsVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6" x-data="{ search: '' }">
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					@PageHeader("Actuators", "Autonomous execution units and fast-path heuristics")
					<div class="relative w-full sm:w-72">
						<input
							type="text"
							placeholder="Search actuators..."
							class="w-full bg-base-100 rounded-full border border-base-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
							x-model="search"
						/>
					</div>
				</div>

				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					if len(vm.Automations) == 0 {
						<div class="p-12 text-center text-base-content/50 text-sm">
							No actuators found in binary directory.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-3.5 pl-6">Name / ID</th>
										<th class="py-3.5">Description</th>
										<th class="py-3.5">Triggers</th>
										<th class="py-3.5">Routing Mode</th>
										<th class="py-3.5 pr-6 text-right"></th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, auto := range vm.Automations {
										<tr
											class="hover:bg-base-200/50 transition-colors"
											x-show={ fmt.Sprintf("!search || $el.innerText.toLowerCase().includes(search.toLowerCase())") }
										>
											<td class="pl-6 py-4">
												<div class="font-semibold text-base text-base-content">{ auto.Name }</div>
												<div class="font-mono text-xs text-base-content/60 mt-0.5">{ auto.ActuatorID }</div>
											</td>
											<td class="text-sm py-4 max-w-xs text-base-content/80">
												{ auto.Description }
											</td>
											<td class="text-sm py-4">
												if len(auto.Triggers) > 0 {
													<div class="flex flex-wrap gap-1">
														for _, t := range auto.Triggers {
															<span class="badge badge-sm badge-ghost font-mono text-xs">{ t }</span>
														}
													</div>
												} else {
													<span class="text-base-content/40 text-xs italic">all events / dynamic</span>
												}
											</td>
											<td class="py-4">
												@StatusBadge(auto.Routing)
											</td>
											<td class="pr-6 py-4 text-right">
												<a href={ templ.SafeURL(fmt.Sprintf("/ui/actuators/%s", auto.ActuatorID)) } class="btn btn-ghost btn-sm rounded-full text-primary font-medium">
													View
												</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		}
	}
}

templ ActuatorDetail(vm *ActuatorDetailVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6">
				<div class="flex items-center gap-2">
					<a href="/ui/actuators" class="text-sm text-base-content/60 hover:text-base-content">← Actuators</a>
				</div>

				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					<div>
						<h1 class="text-2xl sm:text-3xl font-bold tracking-tight m3-headline text-base-content">{ vm.Summary.Name }</h1>
						<p class="font-mono text-xs text-base-content/60 mt-1">{ vm.Summary.ActuatorID }</p>
					</div>
					<form
						hx-post={ fmt.Sprintf("/ui/actuators/%s/run", vm.Summary.ActuatorID) }
						hx-target="#run-result"
						hx-swap="innerHTML"
					>
						<button type="submit" class="btn btn-primary rounded-full px-6 font-medium shadow-sm">
							▶ Trigger Run
						</button>
					</form>
				</div>

				<div id="run-result">
					if vm.RunResult != "" {
						@ActuatorRunResult(vm.RunSuccess, vm.RunResult)
					}
				</div>

				<!-- Overview & Capabilities Cards -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="rounded-2xl border border-base-300/80 bg-base-100 p-6 shadow-xs">
						<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/60 mb-3">Actuator Overview</h2>
						<p class="text-sm text-base-content/80 leading-relaxed mb-4">{ vm.Summary.Description }</p>
						<div class="flex flex-col gap-2 text-xs">
							<div class="flex justify-between py-1 border-b border-base-200">
								<span class="text-base-content/60">Routing Mode</span>
								<span>@StatusBadge(vm.Summary.Routing)</span>
							</div>
							if vm.Summary.RuleID != "" {
								<div class="flex justify-between py-1 border-b border-base-200">
									<span class="text-base-content/60">Fast-Path Rule ID</span>
									<span class="font-mono text-base-content">{ vm.Summary.RuleID }</span>
								</div>
								<div class="flex justify-between py-1 border-b border-base-200">
									<span class="text-base-content/60">Expires In</span>
									<span class="font-mono text-base-content">{ vm.Summary.ExpiresIn }</span>
								</div>
							}
						</div>
					</div>

					<div class="rounded-2xl border border-base-300/80 bg-base-100 p-6 shadow-xs">
						<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/60 mb-3">Declared Capabilities (CBAC)</h2>
						if len(vm.Summary.Capabilities) == 0 {
							<p class="text-sm text-base-content/50 italic">No special capabilities declared (sandboxed execution).</p>
						} else {
							<div class="flex flex-col gap-2">
								for _, cap := range vm.Summary.Capabilities {
									<div class="p-3 bg-base-200/50 rounded-xl border border-base-300/50 flex flex-col gap-1">
										<div class="flex items-center justify-between">
											<span class="font-semibold text-xs text-primary">{ cap.Resource }</span>
										</div>
										if cap.Description != "" {
											<div class="text-xs text-base-content/70">{ cap.Description }</div>
										}
									</div>
								}
							</div>
						}
					</div>
				</div>

				<!-- Recent Logs -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 bg-base-100">
						<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/60">Execution Logs</h2>
					</div>
					if len(vm.RecentLogs) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No execution logs recorded for this actuator.
						</div>
					} else {
						<pre class="log-pre text-xs font-mono p-5 max-h-80 overflow-y-auto whitespace-pre-wrap bg-base-200/40 text-base-content/90">
							for _, line := range vm.RecentLogs {
								{ line + "\n" }
							}
						</pre>
					}
				</div>
			</div>
		}
	}
}

templ ActuatorRunResult(success bool, message string) {
	if success {
		<div class="alert alert-success rounded-2xl text-sm py-3 mb-2">{ message }</div>
	} else {
		<div class="alert alert-error rounded-2xl text-sm py-3 mb-2">{ message }</div>
	}
}
