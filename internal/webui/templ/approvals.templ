package templ

import (
	"fmt"
)

templ Approvals(vm *ApprovalsVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6">
				@PageHeader("HITL Approvals", "Human-in-the-loop safety and capability escalation requests")
				@Flash(vm.FlashKind, vm.Flash)

				if len(vm.Approvals) == 0 {
					<div class="rounded-2xl border border-base-300/80 bg-base-100 p-12 text-center shadow-xs flex flex-col items-center justify-center">
						<div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center mb-3">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
							</svg>
						</div>
						<h3 class="text-base font-semibold m3-headline text-base-content">All Clear</h3>
						<p class="text-sm text-base-content/60 mt-1 max-w-sm">No pending approval requests requiring human intervention.</p>
					</div>
				} else {
					<div class="flex flex-col gap-4">
						for _, req := range vm.Approvals {
							<div class="rounded-2xl border border-amber-300/80 dark:border-amber-600/40 bg-base-100 p-6 shadow-sm flex flex-col gap-4">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class="flex items-center gap-2">
											<span class="badge badge-warning font-semibold text-xs uppercase px-2.5 py-1">Pending Approval</span>
											<span class="font-mono text-xs text-base-content/60">ID: { req.RequestID }</span>
										</div>
										<p class="text-base font-medium text-base-content mt-2">{ req.Context }</p>
									</div>
								</div>

								<div class="border-t border-base-200 pt-4">
									<div class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-2">Select Resolution:</div>
									<div class="flex flex-wrap gap-3">
										for i, opt := range req.Options {
											<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/ui/approvals/%s/decide", req.RequestID)) } class="inline">
												<input type="hidden" name="option" value={ itoa(i + 1) }/>
												<button
													type="submit"
													class={ "btn btn-sm rounded-full px-5 text-sm font-medium",
														templ.KV("btn-primary", opt.ActionCode == "allow" || opt.ID == "allow"),
														templ.KV("btn-error btn-outline", opt.ActionCode == "deny" || opt.ID == "deny"),
														templ.KV("btn-neutral", opt.ActionCode != "allow" && opt.ActionCode != "deny" && opt.ID != "allow" && opt.ID != "deny") }
												>
													{ opt.Description }
												</button>
											</form>
										}
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		}
	}
}
