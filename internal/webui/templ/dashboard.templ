package templ

import (
	"fmt"
)

templ Dashboard(vm *DashboardVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6">
				<!-- Header section -->
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					@PageHeader("Dashboard", "Agent overview and operational status")
					<div class="flex items-center gap-2">
						<a href="/ui/approvals" class="btn btn-primary rounded-full px-5 text-sm font-medium shadow-sm">
							HITL Approvals
							if vm.PendingApprovals > 0 {
								<span class="badge badge-error badge-sm text-white ml-1">{ itoa(vm.PendingApprovals) }</span>
							}
						</a>
					</div>
				</div>

				<!-- Stats section (M3 Tonal Metric Cards) -->
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
					@statCard("Actuators", itoa(vm.ActuatorsCount), "compiled & discovered", "primary")
					@statCard("Pending Approvals", itoa(vm.PendingApprovals), "awaiting human decision", "warning")
					@statCard("Tools", itoa(vm.ToolsCount), "registered MCP & builtin", "info")
					@statCard("Integrations", itoa(vm.IntegrationsCount), "sensors active", "neutral")
				</div>

				<!-- Automations / Actuators table -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 flex justify-between items-center bg-base-100">
						<div>
							<h2 class="text-lg font-semibold m3-headline text-base-content">Automations & Actuators</h2>
							<p class="text-sm text-base-content/60">Active fast-path rules and dynamic LLM actuators</p>
						</div>
						<a href="/ui/actuators" class="btn btn-ghost btn-sm rounded-full text-primary font-medium">View all →</a>
					</div>
					if len(vm.Automations) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No automations registered.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-3 pl-6">Actuator</th>
										<th class="py-3">Triggers</th>
										<th class="py-3">Routing</th>
										<th class="py-3 pr-6 text-right"></th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, auto := range vm.Automations {
										<tr class="hover:bg-base-200/50 transition-colors">
											<td class="pl-6 py-3">
												<div class="font-medium text-sm text-base-content">{ auto.Name }</div>
												<div class="font-mono text-xs text-base-content/60">{ auto.ActuatorID }</div>
											</td>
											<td class="text-sm py-3">
												if len(auto.Triggers) > 0 {
													<div class="flex flex-wrap gap-1">
														for _, t := range auto.Triggers {
															<span class="badge badge-sm badge-ghost font-mono text-xs">{ t }</span>
														}
													</div>
												} else {
													<span class="text-base-content/40 text-xs italic">none declared</span>
												}
											</td>
											<td class="py-3">
												@StatusBadge(auto.Routing)
											</td>
											<td class="pr-6 py-3 text-right">
												<a href={ templ.SafeURL(fmt.Sprintf("/ui/actuators/%s", auto.ActuatorID)) } class="btn btn-ghost btn-xs rounded-full text-primary">Details →</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Recent log tail -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 flex justify-between items-center bg-base-100">
						<div>
							<h2 class="text-lg font-semibold m3-headline text-base-content">Recent Activity</h2>
							<p class="text-sm text-base-content/60">Daemon runtime events</p>
						</div>
						<a href="/ui/logs" class="btn btn-ghost btn-sm rounded-full text-primary font-medium">Live logs →</a>
					</div>
					<pre class="log-pre text-xs font-mono p-5 max-h-64 overflow-y-auto whitespace-pre-wrap bg-base-200/40 text-base-content/90">
						for _, line := range vm.RecentLogs {
							{ line + "\n" }
						}
					</pre>
				</div>
			</div>
		}
	}
}

templ statCard(label, value, sub, tone string) {
	<div class="rounded-2xl border border-base-300/80 bg-base-100 p-5 shadow-xs flex flex-col justify-between">
		<div class="text-xs text-base-content/60 font-semibold uppercase tracking-wider">{ label }</div>
		<div class="mt-2 mb-1">
			<div class="text-3xl font-bold m3-headline text-base-content">{ value }</div>
			<div class="text-xs text-base-content/60 mt-0.5">{ sub }</div>
		</div>
	</div>
}
