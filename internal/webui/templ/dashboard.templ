package templ

import (
	"fmt"
	"github.com/brightpuddle/clara/internal/trigger"
)

templ Dashboard(vm *DashboardVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6">
				<!-- Header section -->
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
					@PageHeader("Dashboard", "Supervisor overview, triggers, and execution status")
					<div class="flex items-center gap-2">
						<a href="/ui/triggers" class="btn btn-primary rounded-full px-5 text-sm font-medium shadow-sm">
							Manage Triggers
						</a>
					</div>
				</div>

				<!-- Stats section (M3 Tonal Metric Cards) -->
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
					@statCard("Triggers", itoa(vm.TriggersCount), fmt.Sprintf("%d event, %d sched, %d worker, %d manual", vm.EventTriggersCount, vm.ScheduleTriggersCount, vm.WorkerTriggersCount, vm.ManualTriggersCount), "primary")
					@statCard("Workers", itoa(vm.WorkerTriggersCount), "supervised background", "accent")
					@statCard("MCP Tools", itoa(vm.ToolsCount), "registered callable tools", "info")
					@statCard("Sensors / MCP", itoa(vm.IntegrationsCount), "integrations active", "neutral")
				</div>

				<!-- Active Triggers Summary -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 flex justify-between items-center bg-base-100">
						<div>
							<h2 class="text-lg font-semibold m3-headline text-base-content">Configured Triggers</h2>
							<p class="text-sm text-base-content/60">Event rules, schedules, and worker processes</p>
						</div>
						<a href="/ui/triggers" class="btn btn-ghost btn-sm rounded-full text-primary font-medium">View all →</a>
					</div>
					if len(vm.Triggers) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No triggers configured.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-3 pl-6">Trigger ID</th>
										<th class="py-3">Type</th>
										<th class="py-3">Match / Schedule</th>
										<th class="py-3">Command</th>
										<th class="py-3 pr-6 text-right"></th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, t := range vm.Triggers {
										<tr class="hover:bg-base-200/50 transition-colors">
											<td class="pl-6 py-3">
												<div class="font-medium text-sm text-base-content">{ t.ID }</div>
												if t.Name != "" && t.Name != t.ID {
													<div class="text-xs text-base-content/60">{ t.Name }</div>
												}
											</td>
											<td class="py-3">
												if t.Type == trigger.TypeEvent {
													<span class="badge badge-secondary badge-sm">event</span>
												} else if t.Type == trigger.TypeSchedule {
													<span class="badge badge-accent badge-sm">schedule</span>
												} else if t.Type == trigger.TypeWorker {
													<span class="badge badge-info badge-sm">worker</span>
												} else if t.Type == trigger.TypeManual {
													<span class="badge badge-primary badge-sm">manual</span>
												}
											</td>
											<td class="text-sm py-3 font-mono text-xs">
												if t.Type == trigger.TypeSchedule {
													{ t.Schedule }
												} else if t.Type == trigger.TypeEvent {
													if t.Match != nil && t.Match.Field != "" {
														{ fmt.Sprintf("%s %s %v", t.Match.Field, t.Match.Op, t.Match.Value) }
													} else {
														{ "*" }
													}
												} else if t.Type == trigger.TypeWorker {
													{ fmt.Sprintf("restart:%s", t.Action.Restart) }
												} else {
													{ "manual" }
												}
											</td>
											<td class="text-xs font-mono py-3 truncate max-w-xs">{ t.Action.Exec }</td>
											<td class="pr-6 py-3 text-right">
												<a href={ templ.SafeURL(fmt.Sprintf("/ui/triggers/%s", t.ID)) } class="btn btn-ghost btn-xs rounded-full text-primary">Details →</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Recent Execution Runs -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 flex justify-between items-center bg-base-100">
						<div>
							<h2 class="text-lg font-semibold m3-headline text-base-content">Recent Script Executions</h2>
							<p class="text-sm text-base-content/60">Supervised script runs and exit codes</p>
						</div>
						<a href="/ui/runs" class="btn btn-ghost btn-sm rounded-full text-primary font-medium">View all runs →</a>
					</div>
					if len(vm.RecentRuns) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No execution runs recorded yet.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full table-xs">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-2.5 pl-6">Run ID</th>
										<th class="py-2.5">Trigger</th>
										<th class="py-2.5">Status</th>
										<th class="py-2.5">Duration</th>
										<th class="py-2.5">Started At</th>
										<th class="py-2.5 pr-6 text-right"></th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, r := range vm.RecentRuns {
										<tr class="hover:bg-base-200/50 transition-colors font-mono">
											<td class="pl-6 py-2">{ r.ID }</td>
											<td class="font-sans font-medium">{ r.TriggerID }</td>
											<td>
												if r.Status == "success" {
													<span class="badge badge-success badge-xs">success</span>
												} else if r.Status == "failure" {
													<span class="badge badge-error badge-xs">failure</span>
												} else {
													<span class="badge badge-warning badge-xs">{ r.Status }</span>
												}
											</td>
											<td>{ fmt.Sprintf("%dms", r.DurationMs) }</td>
											<td class="font-sans text-base-content/60">{ r.StartedAt.Format("15:04:05") }</td>
											<td class="pr-6 py-2 text-right">
												<a href={ templ.SafeURL(fmt.Sprintf("/ui/runs?id=%s", r.ID)) } class="btn btn-ghost btn-xs rounded-full font-sans text-primary">View →</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Recent log tail -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 flex justify-between items-center bg-base-100">
						<div>
							<h2 class="text-lg font-semibold m3-headline text-base-content">Recent Daemon Activity</h2>
							<p class="text-sm text-base-content/60">Clara runtime logs</p>
						</div>
						<a href="/ui/logs" class="btn btn-ghost btn-sm rounded-full text-primary font-medium">Live logs →</a>
					</div>
					<pre class="log-pre text-xs font-mono p-5 max-h-64 overflow-y-auto whitespace-pre-wrap bg-base-200/40 text-base-content/90">
						for _, line := range vm.RecentLogs {
							{ line + "\n" }
						}
					</pre>
				</div>
			</div>
		}
	}
}
