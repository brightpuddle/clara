package templ

templ Integrations(vm *IntegrationsVM) {
	@Index(vm.Base.Index) {
		@Layout(vm.Base.Layout) {
			<div class="flex flex-col gap-6">
				@PageHeader("Integrations & Sensors", "Integration plugins and MCP tool providers")

				<!-- Native Plugins (Sensors) -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 bg-base-100">
						<h2 class="text-lg font-semibold m3-headline text-base-content">Native Plugins</h2>
						<p class="text-sm text-base-content/60">Core sensors emitting CloudEvents</p>
					</div>
					if len(vm.Plugins) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No native plugins configured.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-3 pl-6">Plugin Name</th>
										<th class="py-3 pr-6 text-right">Status</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, p := range vm.Plugins {
										<tr class="hover:bg-base-200/50 transition-colors">
											<td class="pl-6 py-3 font-mono text-sm font-medium text-base-content">{ strVal(p["name"]) }</td>
											<td class="pr-6 py-3 text-right">
												@StatusBadge(strVal(p["status"]))
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- MCP Servers -->
				<div class="rounded-2xl border border-base-300/80 bg-base-100 shadow-xs overflow-hidden">
					<div class="px-6 py-4 border-b border-base-300/70 bg-base-100">
						<h2 class="text-lg font-semibold m3-headline text-base-content">MCP Servers</h2>
						<p class="text-sm text-base-content/60">Model Context Protocol tool endpoints</p>
					</div>
					if len(vm.MCPServers) == 0 {
						<div class="p-8 text-center text-base-content/50 text-sm">
							No MCP servers configured.
						</div>
					} else {
						<div class="overflow-x-auto">
							<table class="table w-full">
								<thead>
									<tr class="border-b border-base-200 text-xs font-semibold text-base-content/70 uppercase tracking-wider bg-base-200/40">
										<th class="py-3 pl-6">Server Identifier</th>
										<th class="py-3 pr-6 text-right">Status</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-base-200/70">
									for _, s := range vm.MCPServers {
										<tr class="hover:bg-base-200/50 transition-colors">
											<td class="pl-6 py-3 font-mono text-sm font-medium text-base-content">{ strVal(s["name"]) }</td>
											<td class="pr-6 py-3 text-right">
												@StatusBadge(strVal(s["status"]))
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		}
	}
}
