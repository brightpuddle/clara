package templ

// ConfigData holds data for the configuration editor page.
type ConfigData struct {
	YAML      string
	Flash     string
	FlashKind string
	ReadOnly  bool // true when no writable config path is available
}

// Config renders the YAML configuration editor.
templ Config(d ConfigData) {
	@Layout("Configuration", "/ui/config") {
		@PageHeader("Configuration", "Edit the agent configuration file")
		@Flash(d.FlashKind, d.Flash)
		if d.ReadOnly {
			<div class="alert alert-warning mb-4">
				<span>Configuration file path is not set — changes cannot be saved.</span>
			</div>
		}
		<form method="POST" action="/ui/config">
			<div class="card bg-base-200 shadow-sm">
				<div class="card-body p-0">
					<div class="px-5 py-4 border-b border-base-300">
						<h2 class="text-sm font-semibold uppercase tracking-widest text-base-content/60">config.yaml</h2>
					</div>
					<div class="p-4">
						<textarea
							name="yaml"
							class="textarea textarea-bordered w-full font-mono text-xs min-h-[60vh] bg-base-100"
							spellcheck="false"
							readonly?={ d.ReadOnly }
						>{ d.YAML }</textarea>
					</div>
					if !d.ReadOnly {
						<div class="px-5 py-4 border-t border-base-300 flex justify-end gap-2">
							<button type="submit" class="btn btn-primary btn-sm">Save</button>
						</div>
					}
				</div>
			</div>
		</form>
	}
}
